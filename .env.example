# ── Supabase (client / optional — app uses Prisma + JWT today) ──
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# ── Supabase PostgreSQL ─────────────────────────────────────
# Replace [YOUR_PROJECT_REF] and [YOUR_PASSWORD] with your actual database details.
# Ensure your password is URL-encoded (e.g., @ becomes %40)
# For the app (Transaction Mode - Port 6543)
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@[YOUR_REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# For Prisma db push (Session Mode - Port 5432)
DIRECT_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@[YOUR_REGION].pooler.supabase.com:5432/postgres"

# ── Auth (JWT for login sessions) ─────────────────────────
JWT_SECRET="your-super-secure-jwt-secret-key"

# ── Upstash Redis (Socket.io real-time) ───────────────────
REDIS_URL="rediss://default:[YOUR_PASSWORD]@[YOUR_ENDPOINT].upstash.io:6379"
UPSTASH_REDIS_REST_URL="https://[YOUR_ENDPOINT].upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# ── Gmail (Nodemailer notifications) ───────────────────────
EMAIL_USER="your.email@gmail.com"
EMAIL_PASS="your-16-char-app-password"

# ── Escalation reminders (days) ───────────────────────────
# Default thresholds for node-cron escalation jobs
ESCALATION_GOAL_SUBMIT_DAYS=7
ESCALATION_GOAL_APPROVE_DAYS=5
ESCALATION_CHECKIN_DAYS=7

# ── App URL ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"